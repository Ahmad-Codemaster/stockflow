# Environment Configuration for StockFlow

# Server Environment
NODE_ENV=development
PORT=3001

# Database Connection (PostgreSQL connection URL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/stockflow?schema=public"

# Session Security Secret (Cryptographically random string >= 32 chars)
SESSION_SECRET="stockflow-secure-random-session-secret-key-32-chars-min"

# Client CORS Origin
CORS_ORIGIN="http://localhost:5173"
