# Environment Configuration for StockFlow

# Server Environment
NODE_ENV=development
PORT=3001

# Database Connection (PostgreSQL for production/development or SQLite for local dev/testing)
DATABASE_URL="file:./dev.db"

# Session Security Secret (Cryptographically random string >= 32 chars)
SESSION_SECRET="stockflow-secure-random-session-secret-key-32-chars-min"

# Client CORS Origin
CORS_ORIGIN="http://localhost:5173"
