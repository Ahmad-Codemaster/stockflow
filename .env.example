# Environment Configuration for StockFlow

# Server Environment
NODE_ENV=development
PORT=3001

# Database Connection (Supabase / PostgreSQL)
# 1. DATABASE_URL: Connect to Supabase via Supavisor connection pooler (Transaction mode, port 6543)
# Format: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:password@localhost:5432/stockflow?schema=public"

# 2. DIRECT_URL: Direct PostgreSQL connection used by Prisma CLI for migrations (Session mode, port 5432)
# Format: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DIRECT_URL="postgresql://postgres:password@localhost:5432/stockflow?schema=public"

# Session Security Secret (Cryptographically random string >= 32 chars)
SESSION_SECRET="stockflow-secure-random-session-secret-key-32-chars-min"

# Client CORS Origin
CORS_ORIGIN="http://localhost:5173"

